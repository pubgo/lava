# lava 配置文件示例
# 配置文件可以放在以下位置（按优先级从高到低）：
# 1. .lava/lava.yaml
# 2. .lava.yaml
# 3. lava.yaml
#
# 注意：`lava curl` 仅支持命令行 flags，不读取本文件。见 docs/lava-command.md。

# watch 命令配置
watch:
  # watcher 列表，可以配置多个 watcher
  watchers:
    # watcher 1：监控 proto 文件
    - name: "proto"
      directory: "./proto"
      patterns:
        - "*.proto"
      commands:
        - "task proto:gen"
      ignore:
        - ".git"
        - "vendor"
      ignore_patterns:
        - "*.tmp"
        - "*~"
      run_on_startup: false
      timeout: 30

    # watcher 2：监控 go 文件
    - name: "go"
      directory: "."
      patterns:
        - "*.go"
      commands:
        - "go build ./..."
      ignore:
        - ".git"
        - "node_modules"
        - "vendor"
        - "dist"
        - "build"
      ignore_patterns:
        - "*.tmp"
        - "*~"
        - ".DS_Store"
      run_on_startup: false
      timeout: 30

    # watcher 3：监控配置文件
    - name: "config"
      directory: "./internal/configs"
      patterns:
        - "*.yaml"
      commands:
        - "echo 'Config changed, reloading...'"
      ignore:
        - ".git"
      run_on_startup: false
      timeout: 10
